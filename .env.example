# ----- App -----
NODE_ENV=development
PORT=3000

# ----- Postgres (local, levantado por docker-compose) -----
DATABASE_URL=postgresql://eiteck:eiteck_dev_password@localhost:5434/eiteck_reservations

# ----- Auth -----
# Generar uno nuevo con: openssl rand -base64 48
JWT_SECRET=replace_me_with_a_random_64_char_string_aaaaaaaaaaaaaaaa
# Vida del access token (corto a propósito; se renueva con /auth/refresh)
JWT_EXPIRES_IN=15m
# Vida del refresh token (rotativo, en días)
REFRESH_TOKEN_TTL_DAYS=7