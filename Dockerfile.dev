# Dockerfile.dev: imagen de desarrollo con hot reload (usada por docker-compose)
FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY tsconfig.json tsconfig.build.json nest-cli.json ./

EXPOSE 3000

# Al arrancar: aplica migraciones y seed (idempotente) y luego levanta la API
# en modo watch. El seed se ejecuta con ts-node porque en desarrollo no hay
# dist/ compilado. Requiere el volumen de ./src y ./scripts (ver docker-compose).
CMD ["sh", "-c", "node scripts/run-migrations.js && npx ts-node src/data/seeds/initial-seed.ts && exec npx nest start --watch"]